{
  "name": "voxbridge-node-tools",
  "version": "0.1.0",
  "description": "Node.js tools for complex GLTF/GLB processing in VoxBridge",
  "main": "simple_processor.js",
  "bin": {
    "process-complex": "./simple_processor.js"
  },
  "scripts": {
    "process": "node simple_processor.js",
    "validate": "node validate.js",
    "roblox-map": "node roblox_map.js",
    "unity-preset": "node unity_preset.js",
    "build": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output ../build/node_binary/voxbridge-node"
  },
  "dependencies": {
    "@gltf-transform/core": "^3.10.0",
    "@gltf-transform/extensions": "^3.10.0",
    "@gltf-transform/functions": "^3.10.1",
    "commander": "^11.1.0",
    "fs-extra": "^11.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "gltf",
    "glb",
    "3d",
    "converter",
    "voxbridge"
  ],
  "author": "VoxBridge Team",
  "license": "MIT",
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "nexe": "^5.0.0-beta.4",
    "pkg": "^5.8.1"
  }
}
